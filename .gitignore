# Node
node_modules/

# Python caches
__pycache__/
*.py[cod]

# Model weights and Checkpoints
*.pt
*.pth
*.safetensors
*.bin
*.ckpt
*.gguf
*.ggml
*.h5
*.pb
*.onnx

# Datasets / Large data
*.csv
*.tsv
*.parquet
# Each module keeps only its own source CSV — all derived files are generated at runtime
!Topological-Reasoning/dataset/topological_relations.csv
!Cardinal-Reasoning/dataset/cardinal_direction_relations.csv
!Relative-Reasoning/dataset/relative_direction_relations.csv
# The train/eval SPLITS must be versioned too, not regenerated on the server.
# They are the experiment's inputs: a split rebuilt elsewhere is a different
# split, and pairing a new eval with a stale train silently reintroduces the
# train/eval leakage the pair-disjoint rebuild removed.
!Topological-Reasoning/dataset/topo_v2_train.csv
!Topological-Reasoning/dataset/topo_v2_eval.csv
!Cardinal-Reasoning/dataset/cardinal_nokg_train.csv
!Relative-Reasoning/dataset/relative_balanced_train.csv

# Tool config
.claude/

# Experiment outputs (generated at runtime)
results/
*.log
*.html
finetuned_gptoss_*/
*cache.json

# Jupyter
.ipynb_checkpoints/

# OS generated files
.DS_Store
*.tar.gz
.vscode/
**/.vscode/
Data Collection/locations.json
__pycache__/
.exp_running.lock
